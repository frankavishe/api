// Data model for features 001 (foundation/auth) and 002 (end-to-end encrypted messaging).
// The server only stores Signal public keys and opaque ciphertext for 002.
// Ids are UUIDv7 generated by the API (sortable by creation time).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  // Explicit so `prisma generate` emits `.js` import specifiers even when no
  // tsconfig.json is present (e.g. the Docker build stage runs generate first).
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum DeviceType {
  android
  web
}

enum RevokedReason {
  signed_out
  replaced
  evicted
  token_reuse
  inactive
}

model User {
  id          String   @id @db.Uuid
  phoneE164   String   @unique @map("phone_e164")
  displayName String?  @map("display_name") @db.VarChar(25)
  about       String   @default("Hey there! I am using Chat App.") @db.VarChar(140)
  avatarKey   String?  @map("avatar_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  devices     Device[]
  contacts    Contact[]            @relation("ContactOwner")
  contactOf   Contact[]            @relation("ContactTarget")
  memberships ConversationMember[]

  @@map("users")
}

model Device {
  id            String         @id @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  type          DeviceType
  name          String         @db.VarChar(64)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt  DateTime       @default(now()) @map("last_active_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedReason RevokedReason? @map("revoked_reason")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     Session[]
  keys         DeviceKeys?
  signedPreKey SignedPreKey?
  oneTimeKeys  OneTimePreKey[]
  envelopes    Envelope[]

  @@index([userId])
  @@map("devices")
}

model Session {
  id          String    @id @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  refreshHash String    @unique @map("refresh_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt   DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("sessions")
}

model OtpChallenge {
  id         String    @id @db.Uuid
  phoneE164  String    @map("phone_e164")
  codeHmac   String    @map("code_hmac") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0) @db.SmallInt
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

model Contact {
  ownerId       String   @map("owner_id") @db.Uuid
  contactUserId String   @map("contact_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner       User @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactUser User @relation("ContactTarget", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@id([ownerId, contactUserId])
  @@index([contactUserId])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Feature 002: end-to-end encrypted messaging
// ---------------------------------------------------------------------------

enum ConversationType {
  direct
  group
}

enum MemberRole {
  admin
  member
}

enum EnvelopeType {
  prekey
  whisper
}

/// Signal identity of one device. Keys are stored as raw bytes (33-byte 0x05-prefixed).
model DeviceKeys {
  deviceId       String   @id @map("device_id") @db.Uuid
  registrationId Int      @map("registration_id")
  identityKey    Bytes    @map("identity_key")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_keys")
}

model SignedPreKey {
  deviceId  String   @id @map("device_id") @db.Uuid
  keyId     Int      @map("key_id")
  publicKey Bytes    @map("public_key")
  signature Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("signed_prekeys")
}

/// Deleted as soon as it is handed out in a bundle.
model OneTimePreKey {
  deviceId  String   @map("device_id") @db.Uuid
  keyId     Int      @map("key_id")
  publicKey Bytes    @map("public_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, keyId])
  @@map("one_time_prekeys")
}

model Conversation {
  id        String           @id @db.Uuid
  type      ConversationType
  /// Sorted "userA:userB" for direct chats; makes creation idempotent.
  directKey String?          @unique @map("direct_key")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  members   ConversationMember[]
  envelopes Envelope[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String     @map("conversation_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  role           MemberRole @default(member)
  joinedAt       DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// One ciphertext waiting for one device. Deleted when the device acks it.
model Envelope {
  id                String       @id @db.Uuid
  recipientDeviceId String       @map("recipient_device_id") @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  senderUserId      String       @map("sender_user_id") @db.Uuid
  senderDeviceId    String       @map("sender_device_id") @db.Uuid
  type              EnvelopeType
  ciphertext        Bytes
  serverTimestamp   DateTime     @map("server_timestamp") @db.Timestamptz(3)

  recipient    Device       @relation(fields: [recipientDeviceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([recipientDeviceId, id])
  @@map("envelopes")
}
