# --- Local infrastructure (docker compose) ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat
# Host ports (5433/6380 avoid clashing with a locally installed Postgres/Redis)
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_ROOT_USER=chatminio
MINIO_ROOT_PASSWORD=chatminio-secret

# --- API ---
NODE_ENV=development
PORT=3000
# URL the API is reachable at (used to build avatar URLs)
PUBLIC_URL=http://localhost:3000
# Web app origin allowed by CORS (credentials enabled)
WEB_ORIGIN=http://localhost:3001

DATABASE_URL=postgresql://chat:chat@localhost:5433/chat?schema=public
REDIS_URL=redis://localhost:6380

# Generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
OTP_PEPPER=dev-only-otp-pepper-change-me

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=chatminio
S3_SECRET_KEY=chatminio-secret
S3_BUCKET_AVATARS=avatars
